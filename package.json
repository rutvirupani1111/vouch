{
  "name": "vouchjs",
  "version": "0.1.0",
  "description": "Know an npm package is safe before you install it: what it can do, whether it matches its source, and whether its vulnerabilities reach your code.",
  "keywords": [
    "supply-chain",
    "security",
    "npm",
    "provenance",
    "slsa",
    "sigstore",
    "lockfile",
    "capabilities",
    "malware",
    "install-scripts"
  ],
  "license": "MIT",
  "author": "Rutvi Rupani",
  "type": "module",
  "bin": {
    "vouch": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutvirupani1111/vouch.git"
  },
  "homepage": "https://github.com/rutvirupani1111/vouch#readme",
  "bugs": {
    "url": "https://github.com/rutvirupani1111/vouch/issues"
  }
}
